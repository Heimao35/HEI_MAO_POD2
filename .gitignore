# =============================================================================
# esp32p4-idf5_co5300-mipi_esp-lvgl-port_lvgl9  --  .gitignore
#
# Rule of thumb: only build outputs and auto-regenerated files are ignored.
# sdkconfig / sdkconfig.defaults / dependencies.lock stay versioned so that a
# fresh clone reproduces the exact same configuration and component versions.
# Exception: internal hardware notes (AGENTS.md, docs/) are intentionally
# untracked for the public repository; see section 6.
# =============================================================================

# --- 1. ESP-IDF build output (fully regenerated by `idf.py build`) -----------
/build/
build_*/

# Stray firmware artifacts in the project root (normally land in build/)
/*.bin
/*.elf
/*.map
/*.hex

# --- 2. Dependencies fetched by IDF Component Manager -----------------------
# Recreated from main/idf_component.yml + dependencies.lock; never edited by hand
managed_components/
.component_hash

# --- 3. Generated / backup files -------------------------------------------
sdkconfig.old
*.bak
*.tmp
*~
__pycache__/
*.pyc

# --- 4. IDE / editor --------------------------------------------------------
# .vscode/settings.json holds machine-specific absolute paths that would break
# other setups; use `git add -f <file>` if you ever want to share one.
.vscode/
.clangd
.cache/

# --- 5. OS ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- 6. Internal hardware notes (not part of the public repository) --------
# Board wiring, datasheet findings, register mappings and debug history stay
# on the author's disk but must not be published. Keep local copies.
/AGENTS.md
/docs/
